
@model WebApplicationDemo.Models.City



@{ Layout = "_Layout"; ViewBag.Title = "Get City by Id";}

<h2>Get City by Id </h2>
<h3>@ViewBag.StatusCode</h3>
<form method="post">
    <div class="form-group">
        <label for="State_Id">Enter ID of City</label>
        <input class="form-control" name="id" />
    </div>
    <div class="text-center panel-body">
        <button type="submit" class="btn btn-sm btn-primary">Get City</button>
        <a asp-action="Index" class="btn btn-sm btn-primary">Back</a>
    </div>
</form>

@if (Model != null)
{
    <h2>City</h2>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>

            <tr>
                <th>ID</th>
                <th>City</th>
                <th>State</th>
                <th>Country</th>
            </tr>

        <tbody>
            <tr>
                <td>@Model.City_Id</td>
                <td>@Model.City_Name</td>
                <td>@Model.State.State_Name</td>
                <td>@Model.State.Country.Country_Name</td>

            </tr>
        </tbody>

    </table>
}