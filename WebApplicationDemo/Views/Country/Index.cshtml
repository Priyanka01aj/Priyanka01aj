@model IEnumerable<WebApplicationDemo.Models.Country>

@{
    ViewData["Title"] = "Index";
}

<h1>Country</h1>

<p>
    <a asp-action="AddNew">Create New</a>|
    <a asp-action="GetCountry" class="btn btn-sm btn-secondary">Get Country</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Country_Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Country_Name)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Country_Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Country_Id">Details</a> |

                    <a asp-action="Delete" asp-route-id="@item.Country_Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
