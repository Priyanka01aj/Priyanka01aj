@model WebApplicationDemo.Models.Employee

@{
    ViewData["Title"] = "Edit";
}
<head>
    <script src="\lib\jquery\dist\jquery.js"></script>

    <script>

        $(document).ready(function () {
            $("#City_State_Country_Id").change(function () {
                var items = "<option value='0'>Select</option>";
                $("#CityId").html(items);
            //var country = $("select#State_Country_Id option:selected").val();
            var url = '@Url.Content("~/")' + "Employee/GetState";
            var ddlsource = "#City_State_Country_Id";
            $.get(url, { countryId: $(ddlsource).val() }, function (data) {
                var items = '';
                $("#City_State_Id").empty();
                $.each(data, function (i, state) {
                    items += "<option value='" + state.value + "'>" + state.text + "</option>";
                });
                $("#City_State_Id").html(items);
            }
            );
            //var items = "<option value='0'>Select</option>";
            //$("#City_State_Id").html(items);

        });
        //var items = "<option value='0'>select</option>";
        //$("#City_State_Id").html(items);


     $("#City_State_Id").change(function () {
            //var country = $("select#State_Country_Id option:selected").val();
            var url = '@Url.Content("~/")' + "Employee/GetCity";
            var ddlsource = "#City_State_Id";
            $.get(url, { stateId: $(ddlsource).val() }, function (data) {
                var items = '';
                $("#CityId").empty();
                $.each(data, function (i, city) {
                    items += "<option value='" + city.value + "'>" + city.text + "</option>";
                });
                $("#CityId").html(items);
            }
            );
        //  var items = "<option value='0'>Select</option>";
        //$("#CityId").html(items);

        });
        //var items = "<option value='0'>select</option>";
        //$("#CityId").html(items);
    });

    </script>
</head>

<h1>Edit</h1>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="City.State.Country_Id" class="control-label">Country</label>
                <select asp-for="City.State.Country_Id" class="form-control" asp-items="@(new SelectList(ViewBag.country,"Country_Id","Country_Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="City.State_Id" class="control-label">State</label>
                <select asp-for="City.State_Id" class="form-control" asp-items="@(new SelectList(ViewBag.st,"State_Id","State_Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="CityId" class="control-label">City</label>
                <select asp-for="CityId" class="form-control" asp-items="@(new SelectList(ViewBag.city,"City_Id","City_Name"))"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
