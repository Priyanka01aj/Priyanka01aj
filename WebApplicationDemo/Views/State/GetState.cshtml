@model WebApplicationDemo.Models.State



@{ Layout = "_Layout"; ViewBag.Title = "Get State by Id";}

<h2>Get State by Id <a asp-action="Index" class="btn btn-sm btn-primary">Back</a></h2>
<h3>@ViewBag.StatusCode</h3>
<form method="post">
    <div class="form-group">
        <label for="State_Id">Id:</label>
        <input class="form-control" name="id" />
    </div>
    <div class="text-center panel-body">
        <button type="submit" class="btn btn-sm btn-primary">Get State</button>
    </div>
</form>

@if (Model != null)
{
    <h2>State</h2>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>

            <tr>
                <th>ID</th>
                <th>State</th>
                <th>Country</th>
            </tr>

        <tbody>
            <tr>
                <td>@Model.State_Id</td>
                <td>@Model.State_Name</td>
                <td>@Model.Country.Country_Name</td>

            </tr>
        </tbody>

    </table>
}
