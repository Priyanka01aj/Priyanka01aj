@model IEnumerable<WebApplicationDemo.Models.State>

@{
    ViewData["Title"] = "States";

}

<h1>State</h1>

<p>
    <a asp-action="AddNew">Create New</a>|
    <a asp-action="GetState" class="btn btn-sm btn-secondary">Get State</a>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.State_Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country.Country_Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.State_Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Country.Country_Name)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.State_Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.State_Id">Details</a> |

                    <a asp-action="Delete" asp-route-id="@item.State_Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
